# Path to SQLite DB file provided by notes_database container.
# Example: SQLITE_DB=/home/kavia/workspace/code-generation/note-keeper-337662-337677/notes_database/notes.db
SQLITE_DB=

# Optional: CORS allow-list for the frontend origin(s).
# Comma-separated list of allowed origins, e.g.
# NOTES_CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.example.com
# If unset, the backend defaults to "*" (credentials disabled).
NOTES_CORS_ALLOW_ORIGINS=
